---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import quiquiaCover from '../assets/img/project-quiquia.svg';
import eclipsebotCover from '../assets/img/project-eclipsebot.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const covers = [quiquiaCover, eclipsebotCover];
const slugs = ['quiquia', 'eclipsebot'];
const repos = [
  'https://github.com/qSEBASp/Quiqu.ia',
  'https://github.com/qSEBASp/EclipseBot-Discord',
];
const coversAlt = [
  lang === 'es' ? 'Portada de Quiqu.ia: coach de Valorant con IA' : 'Quiqu.ia cover: Valorant coach with AI',
  lang === 'es' ? 'Portada de EclipseBot: bot de Discord' : 'EclipseBot cover: Discord bot',
];
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <div class="section__head" data-reveal>
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h2 class="section__title" id="projects-title">{t.projects.title}</h2>
      <p class="section__lead">{t.projects.lead}</p>
    </div>

    <div class="projects">
      {t.projects.list.map((project, i) => {
        const cover = covers[i];
        const slug = slugs[i];
        return (
          <article class="project" class:list={[{ 'project--reverse': i % 2 === 1 }]} data-reveal>
            <div class="project__media">
              <span class="project__index">{project.index}</span>
              {cover.format === 'svg' ? (
                <img
                  src={cover.src}
                  width={cover.width}
                  height={cover.height}
                  alt={coversAlt[i]}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={cover}
                  widths={[600, 900, 1200]}
                  sizes="(max-width: 860px) 100vw, 50vw"
                  alt={coversAlt[i]}
                  format="webp"
                  quality={78}
                  loading="lazy"
                />
              )}
            </div>

            <div class="project__body">
              <p class="project__kicker">
                {project.kicker.map((item) => <span>{item}</span>)}
              </p>
              <h3 class="project__title">{project.title}</h3>
              <p class="project__desc">{project.summary}</p>
              <ul class="project__tags">
                {project.tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
              <div class="project__actions">
                <button class="btn btn--primary" type="button" data-open-case={slug}>
                  {t.actions.case}
                  <Icon name="corner" size={15} />
                </button>
                <a class="btn btn--ghost" href={repos[i]} target="_blank" rel="noopener noreferrer">
                  <Icon name="github" size={15} />
                  {t.actions.repo}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="others" data-reveal>
      <p class="eyebrow" style="margin-bottom: 0.75rem;">{t.projects.othersTitle}</p>
      {t.projects.others.map((other) => (
        other.href ? (
          <a class="others__row" href={other.href} target="_blank" rel="noopener noreferrer">
            <span class="others__name">{other.name}</span>
            <span class="others__desc">{other.desc}</span>
            <span class="others__link">{other.linkLabel} ↗</span>
          </a>
        ) : (
          <div class="others__row">
            <span class="others__name">{other.name}</span>
            <span class="others__desc">{other.desc}</span>
          </div>
        )
      ))}
    </div>
  </div>
</section>

{t.projects.list.map((project, i) => {
  const cover = covers[i];
  const slug = slugs[i];
  return (
    <dialog
      class="sheet"
      id={`case-${slug}`}
      aria-labelledby={`case-${slug}-title`}
    >
      <div class="sheet__scroll">
        <div class="sheet__head">
          <div>
            <p class="sheet__kicker">{project.index} · {project.kicker.join(' · ')}</p>
            <h2 class="sheet__title" id={`case-${slug}-title`}>{project.title}</h2>
          </div>
          <button class="sheet__close" type="button" data-close-dialog aria-label={t.a11y.close}>
            <Icon name="close" size={16} />
          </button>
        </div>

        <div class="sheet__body">
          {cover.format === 'svg' ? (
            <img
              class="sheet__cover"
              src={cover.src}
              width={cover.width}
              height={cover.height}
              alt={coversAlt[i]}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              class="sheet__cover"
              src={cover}
              widths={[640, 960]}
              sizes="(max-width: 760px) 92vw, 700px"
              alt={coversAlt[i]}
              format="webp"
              quality={80}
              loading="lazy"
            />
          )}

          <div class="sheet__block">
            <h4>{t.projects.study.problem}</h4>
            <p>{project.problem}</p>
          </div>

          <div class="sheet__block">
            <h4>{t.projects.study.built}</h4>
            <ul>
              {project.built.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="sheet__block">
            <h4>{t.projects.study.learned}</h4>
            <p>{project.learned}</p>
          </div>

          <div class="sheet__block">
            <h4>{t.projects.study.stack}</h4>
            <ul class="project__tags">
              {project.tags.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </div>

          <div class="sheet__foot">
            <a class="btn btn--primary" href={repos[i]} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={15} />
              {t.actions.repo}
            </a>
            <button class="btn btn--ghost" type="button" data-close-dialog>
              {t.a11y.close}
            </button>
          </div>
        </div>
      </div>
    </dialog>
  );
})}
