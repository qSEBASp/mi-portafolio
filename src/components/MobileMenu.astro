---
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { asset, localeUrl, otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);

const nav = [
  { id: 'about', label: t.nav.about },
  { id: 'stack', label: t.nav.stack },
  { id: 'projects', label: t.nav.projects },
  { id: 'path', label: t.nav.path },
  { id: 'contact', label: t.nav.contact },
];

const cvFile = lang === 'es' ? 'docs/CV-Sebastian-Quiqui-ES.pdf' : 'docs/CV-Sebastian-Quiqui-EN.pdf';
---

<dialog class="drawer" id="drawer" aria-label={t.a11y.menu}>
  <div class="drawer__inner">
    <div class="drawer__top">
      <a class="brand" href={localeUrl(lang)}>
        <span class="brand__mark">qS</span>
        <span class="brand__name">Sebastián Quiqui</span>
      </a>
      <button class="icon-btn" type="button" data-menu-close aria-label={t.a11y.close}>
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav class="drawer__nav" aria-label={t.a11y.mainNav}>
      {nav.map((item, i) => (
        <a href={`#${item.id}`} data-nav={item.id}>
          <small aria-hidden="true">{String(i + 1).padStart(2, '0')}</small>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="drawer__foot">
      <a class="btn btn--primary" href="#contact">{t.actions.talk}</a>
      <a class="btn btn--ghost" href={asset(cvFile)} download>
        <Icon name="download" size={15} />
        {lang === 'es' ? t.actions.cvEs : t.actions.cvEn}
      </a>
      <a class="btn btn--ghost" href={localeUrl(other)} data-lang-switch={other} hreflang={other} lang={other}>
        {lang === 'es' ? 'English' : 'Español'}
      </a>
      <a
        class="icon-btn"
        href="https://github.com/qSEBASp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <Icon name="github" size={17} />
      </a>
      <a
        class="icon-btn"
        href="https://www.linkedin.com/in/sebas-quiqui-dev/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" size={17} />
      </a>
    </div>
  </div>
</dialog>
